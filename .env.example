# ============================================================
# 合规审查 Agent 系统 - 环境变量模板
# 复制为 .env 后按需修改
# ============================================================

# ========== LLM 配置（Ollama 本地大模型，OpenAI 兼容协议） ==========
LLM_PROVIDER=openai
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=dummy_ollama_key
# 注意：不要用 qwen3 系列推理模型，会先生成 thinking 链，慢 5-10 倍
LLM_MODEL_NAME=qwen2.5:3b

# ========== 向量数据库 ==========
VECTOR_DB_PROVIDER=chroma
CHROMA_PERSIST_PATH=./vector_db

# ========== Embedding 模型（本地路径优先） ==========
# config.py 会自动检测 ./models/bge-small-zh-v1.5 是否存在
# 不存在才回退到在线下载（国内网络极易失败，强烈建议本地化）
# 下载命令：
#   modelscope download --model BAAI/bge-small-zh-v1.5 --local-dir ./models/bge-small-zh-v1.5

# ========== MCP Server 配置 ==========
# 阶段3 Windows 本地开发固定使用 sse
# MCP 服务需独立终端启动：
#   uv run python mcp_server/main.py --transport sse --port 8005
MCP_TRANSPORT=sse
MCP_HOST=127.0.0.1
MCP_PORT=8005
MCP_RETRY_TIMES=2
# 首次检索会慢（加载模型 + 建索引），30 秒容易超时，建议 120
MCP_TIMEOUT=120

# ========== FastAPI Gateway ==========
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# ========== LangGraph Service ==========
LANGGRAPH_HOST=127.0.0.1
LANGGRAPH_PORT=8002

# ========== HITL 持久化存储 ==========
# 当前使用内存 checkpointer（MemorySaver），跨进程不支持
# 如需生产部署，改成 sqlite 或 postgres
LANGGRAPH_DB_URL=sqlite:///./langgraph_threads.db

# ========== 可观测性（可选，不用就留空） ==========
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=compliance-agent