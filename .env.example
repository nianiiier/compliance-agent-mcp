# LLM 配置
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o-mini

# 向量数据库
VECTOR_DB_PROVIDER=chroma
CHROMA_PERSIST_PATH=./vector_db

# MCP Server 配置
# 本地开发 stdio；部署使用 sse
MCP_TRANSPORT=stdio
MCP_SERVER_SSE_URL=http://127.0.0.1:8001/sse

# FastAPI Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# LangGraph Service
LANGGRAPH_HOST=127.0.0.1
LANGGRAPH_PORT=8002

# HITL / 持久化存储，LangGraph sqlite持久化
LANGGRAPH_DB_URL=sqlite:///./langgraph_threads.db

# 可观测性 LangFuse / LangSmith
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

LANGSMITH_API_KEY=
LANGSMITH_PROJECT=compliance-agent
